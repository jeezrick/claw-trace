#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_PATH" ]]; do
  LINK_TARGET="$(readlink "$SCRIPT_PATH")"
  if [[ "$LINK_TARGET" == /* ]]; then
    SCRIPT_PATH="$LINK_TARGET"
  else
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && cd "$(dirname "$LINK_TARGET")" && pwd)/$(basename "$LINK_TARGET")"
  fi
done

if [[ -z "${HOME:-}" ]]; then
  HOME="$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)"
  HOME="${HOME:-/root}"
  export HOME
fi

APP_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
INSTALL_SOURCE_FILE="$APP_DIR/.install-source.env"
DEFAULT_REPO="jeezrick/claw-trace"
SAVED_CLAW_TRACE_INSTALL_SOURCE=""
SAVED_CLAW_TRACE_REPO=""
SAVED_CLAW_TRACE_GITLAB_BASE_URL=""
SAVED_CLAW_TRACE_GITLAB_PACKAGE_NAME=""
if [[ -f "$INSTALL_SOURCE_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$INSTALL_SOURCE_FILE"
fi
REPO="${CLAW_TRACE_REPO:-${SAVED_CLAW_TRACE_REPO:-$DEFAULT_REPO}}"
INSTALL_SOURCE="${CLAW_TRACE_INSTALL_SOURCE:-${SAVED_CLAW_TRACE_INSTALL_SOURCE:-github}}"
GITLAB_BASE_URL="${CLAW_TRACE_GITLAB_BASE_URL:-${SAVED_CLAW_TRACE_GITLAB_BASE_URL:-}}"
GITLAB_PACKAGE_NAME="${CLAW_TRACE_GITLAB_PACKAGE_NAME:-${SAVED_CLAW_TRACE_GITLAB_PACKAGE_NAME:-claw-trace}}"
NODE_VERSION_FALLBACK="${CLAW_TRACE_NODE_VERSION:-20}"
PROJECT_NAME="${REPO##*/}"
OPENCLAW_HOME="${CLAW_TRACE_OPENCLAW_HOME:-$HOME/.openclaw}"
OPENCLAW_DOCTOR_PLUGIN_ID="claw-trace-doctor-plugin"
OPENCLAW_DOCTOR_WITH_AI="${CLAW_TRACE_DOCTOR_WITH_AI:-0}"
STATE_DIR="${CLAW_TRACE_STATE_DIR:-$HOME/.local/state/claw-trace}"
PID_FILE="$STATE_DIR/server.pid"
LOG_FILE="${CLAW_TRACE_LOG_FILE:-/tmp/claw-trace.log}"
PORT="${PORT:-8787}"
HOST="${HOST:-0.0.0.0}"
SESSIONS_DIR="${SESSIONS_DIR:-/root/.openclaw/agents/main/sessions}"
RAW_STREAM_FILE="${RAW_STREAM_FILE:-$HOME/.openclaw/logs/raw-stream.jsonl}"
RAW_POLL_MS="${RAW_POLL_MS:-700}"
DATABASE_FILE="${DATABASE_FILE:-$APP_DIR/apps/server/data/claw-trace-v2.sqlite}"
SERVER_JS="$APP_DIR/apps/server/dist/index.js"
SYSTEMCTL_BIN="${CLAW_TRACE_SYSTEMCTL_BIN:-systemctl}"
JOURNALCTL_BIN="${CLAW_TRACE_JOURNALCTL_BIN:-journalctl}"
SERVICE_NAME="${CLAW_TRACE_SERVICE_NAME:-claw-trace.service}"
SYSTEM_UNIT_PATH="${CLAW_TRACE_SYSTEMD_SYSTEM_UNIT_PATH:-/etc/systemd/system/$SERVICE_NAME}"
USER_UNIT_DIR="${CLAW_TRACE_SYSTEMD_USER_UNIT_DIR:-$HOME/.config/systemd/user}"
USER_UNIT_PATH="$USER_UNIT_DIR/$SERVICE_NAME"

mkdir -p "$STATE_DIR"

version() {
  if [[ -f "$APP_DIR/VERSION" ]]; then
    cat "$APP_DIR/VERSION"
  else
    echo "unknown"
  fi
}

repo_api_path() {
  printf '%s' "${REPO//\//%2F}"
}

normalize_gitlab_base_url() {
  GITLAB_BASE_URL="${GITLAB_BASE_URL%/}"
}

gitlab_bundle_url() {
  local tag="$1"
  normalize_gitlab_base_url
  printf '%s/api/v4/projects/%s/packages/generic/%s/%s/trace-service.tgz' \
    "$GITLAB_BASE_URL" \
    "$(repo_api_path)" \
    "$GITLAB_PACKAGE_NAME" \
    "$tag"
}

download_with_retry() {
  local url="$1"
  local out="$2"
  local tries=8
  local i
  for i in $(seq 1 "$tries"); do
    if curl -fsSL "$url" -o "$out"; then
      return 0
    fi
    echo "download failed (try $i/$tries), retry in 5s..." >&2
    sleep 5
  done
  return 1
}

write_install_source_file() {
  {
    printf 'SAVED_CLAW_TRACE_INSTALL_SOURCE=%q\n' "$INSTALL_SOURCE"
    printf 'SAVED_CLAW_TRACE_REPO=%q\n' "$REPO"
    printf 'SAVED_CLAW_TRACE_GITLAB_BASE_URL=%q\n' "${GITLAB_BASE_URL%/}"
    printf 'SAVED_CLAW_TRACE_GITLAB_PACKAGE_NAME=%q\n' "$GITLAB_PACKAGE_NAME"
  } > "$INSTALL_SOURCE_FILE"
}

load_node_runtime() {
  # shellcheck source=/dev/null
  [[ -s "$HOME/.nvm/nvm.sh" ]] && source "$HOME/.nvm/nvm.sh"
}

current_node_major() {
  if ! command -v node >/dev/null 2>&1; then
    echo 0
    return 0
  fi

  node -p 'const major = Number.parseInt(process.versions.node.split(".")[0], 10); Number.isFinite(major) ? major : 0' 2>/dev/null || echo 0
}

use_fallback_node_version() {
  load_node_runtime

  if ! command -v nvm >/dev/null 2>&1; then
    return 1
  fi

  echo "switching to Node ${NODE_VERSION_FALLBACK} via nvm"

  if ! nvm use "$NODE_VERSION_FALLBACK" >/dev/null 2>&1; then
    echo "installing Node ${NODE_VERSION_FALLBACK} via nvm"
    nvm install "$NODE_VERSION_FALLBACK" >/dev/null
    nvm use "$NODE_VERSION_FALLBACK" >/dev/null
  fi

  hash -r
  return 0
}

ensure_supported_node_runtime() {
  load_node_runtime

  local major
  major="$(current_node_major)"

  if command -v npm >/dev/null 2>&1 && [[ "$major" -ge 18 ]] && [[ "$major" -le 22 ]]; then
    return 0
  fi

  if ! use_fallback_node_version; then
    echo "unsupported or missing Node runtime; install Node 18/20/22 or nvm" >&2
    return 1
  fi

  major="$(current_node_major)"
  [[ "$major" -ge 18 ]] && [[ "$major" -le 22 ]] && command -v npm >/dev/null 2>&1
}

# Return the absolute path to a supported Node binary (18-22) without modifying
# the current shell's PATH.  Used by run_server and diagnosis so that claw-trace
# always runs with the Node version that better-sqlite3 was compiled against,
# while leaving the caller's environment (e.g. OpenClaw's Node 24) untouched.
find_server_node_binary() {
  load_node_runtime

  local major
  major="$(current_node_major)"

  # Current node is already in the supported range — use it directly.
  if command -v node >/dev/null 2>&1 && [[ "$major" -ge 18 ]] && [[ "$major" -le 22 ]]; then
    command -v node
    return 0
  fi

  # Current node is outside 18-22; locate the fallback version via nvm without
  # calling `nvm use` (which would mutate PATH for the calling shell).
  if ! command -v nvm >/dev/null 2>&1; then
    return 1
  fi

  local node_bin
  node_bin="$(nvm which "$NODE_VERSION_FALLBACK" 2>/dev/null || true)"

  if [[ ! -x "${node_bin:-}" ]]; then
    echo "[claw-trace] installing Node ${NODE_VERSION_FALLBACK} via nvm" >&2
    nvm install "$NODE_VERSION_FALLBACK" >/dev/null 2>&1
    node_bin="$(nvm which "$NODE_VERSION_FALLBACK" 2>/dev/null || true)"
  fi

  if [[ ! -x "${node_bin:-}" ]]; then
    return 1
  fi

  echo "$node_bin"
}

gitlab_package_exists() {
  local url="$1"
  local status

  status="$(curl -sSIL -o /dev/null -w '%{http_code}' "$url" || true)"
  [[ "$status" == "200" || "$status" == "302" ]]
}

inject_openclaw_doctor_plugin() {
  local openclaw_config="$OPENCLAW_HOME/openclaw.json"
  local template_dir="$APP_DIR/openclaw-plugin/$OPENCLAW_DOCTOR_PLUGIN_ID"
  local plugin_dir="$OPENCLAW_HOME/extensions/$OPENCLAW_DOCTOR_PLUGIN_ID"
  local doctor_command="$APP_DIR/claw-trace"
  local version_no_v
  local escaped_command

  if [[ ! -f "$openclaw_config" ]]; then
    return 0
  fi

  if [[ ! -d "$template_dir" ]]; then
    echo "OpenClaw doctor plugin template missing at $template_dir" >&2
    return 1
  fi

  version_no_v="$(version)"
  version_no_v="${version_no_v#v}"
  escaped_command="$(printf '%s' "$doctor_command" | sed 's/[\\/&]/\\&/g')"

  mkdir -p "$plugin_dir"
  cp "$template_dir/openclaw.plugin.json" "$plugin_dir/openclaw.plugin.json"
  sed \
    -e "s/__CLAW_TRACE_VERSION__/$version_no_v/g" \
    "$template_dir/package.json" > "$plugin_dir/package.json"
  sed \
    -e "s/__CLAW_TRACE_COMMAND__/$escaped_command/g" \
    -e "s/__CLAW_TRACE_WITH_AI__/$OPENCLAW_DOCTOR_WITH_AI/g" \
    "$template_dir/index.js" > "$plugin_dir/index.js"

  node - "$openclaw_config" "$OPENCLAW_DOCTOR_PLUGIN_ID" "$plugin_dir" "$version_no_v" <<'NODE'
const fs = require('fs');

const [configPath, pluginId, pluginDir, version] = process.argv.slice(2);
const now = new Date().toISOString();
const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));

config.plugins = config.plugins ?? {};
config.plugins.entries = config.plugins.entries ?? {};
config.plugins.installs = config.plugins.installs ?? {};
config.plugins.allow = Array.isArray(config.plugins.allow) ? config.plugins.allow : [];

const prevEntry = config.plugins.entries[pluginId] ?? {};
config.plugins.entries[pluginId] = {
  ...prevEntry,
  enabled: true,
};

const prevInstall = config.plugins.installs[pluginId] ?? {};
config.plugins.installs[pluginId] = {
  source: 'path',
  spec: pluginDir,
  installPath: pluginDir,
  version,
  resolvedName: pluginId,
  resolvedVersion: version,
  resolvedSpec: pluginDir,
  resolvedAt: prevInstall.resolvedAt ?? now,
  installedAt: now,
};

if (!config.plugins.allow.includes(pluginId)) {
  config.plugins.allow.push(pluginId);
}

fs.writeFileSync(configPath, `${JSON.stringify(config, null, 2)}\n`);
NODE

  echo "refreshed OpenClaw plugin: $plugin_dir"
}

restart_openclaw_gateway() {
  if [[ ! -f "$OPENCLAW_HOME/openclaw.json" ]]; then
    return 0
  fi

  if ! command -v openclaw >/dev/null 2>&1; then
    echo "openclaw command not found; skip gateway restart" >&2
    return 1
  fi

  if openclaw gateway restart >/dev/null 2>&1; then
    echo "restarted OpenClaw gateway"
    return 0
  fi

  echo "failed to restart OpenClaw gateway automatically; restart it manually" >&2
  return 1
}

prepare_update_bundle() {
  local tag="$1"
  local out="$2"

  case "$INSTALL_SOURCE" in
    github)
      local url="https://github.com/$REPO/releases/download/$tag/trace-service.tgz"
      echo "downloading $url"
      download_with_retry "$url" "$out"
      ;;
    gitlab)
      if [[ -z "$GITLAB_BASE_URL" ]]; then
        echo "CLAW_TRACE_GITLAB_BASE_URL is required when CLAW_TRACE_INSTALL_SOURCE=gitlab" >&2
        return 1
      fi
      local url
      url="$(gitlab_bundle_url "$tag")"
      if gitlab_package_exists "$url"; then
        echo "downloading $url"
        download_with_retry "$url" "$out"
        return 0
      fi

      echo "GitLab package is not available yet; falling back to source build"
      if ! ensure_supported_node_runtime; then
        return 1
      fi

      local tmp
      local archive
      local src_dir
      local src_root
      local archive_url
      local bundle_root

      tmp="$(mktemp -d)"
      archive="$tmp/${PROJECT_NAME}-${tag}.tar.gz"
      src_dir="$tmp/gitlab-source"
      archive_url="${GITLAB_BASE_URL%/}/$REPO/-/archive/$tag/$PROJECT_NAME-$tag.tar.gz"

      echo "downloading $archive_url"
      download_with_retry "$archive_url" "$archive"
      mkdir -p "$src_dir"
      tar -xzf "$archive" -C "$src_dir"
      src_root="$(find "$src_dir" -mindepth 1 -maxdepth 1 -type d | head -n1)"

      if [[ -z "$src_root" ]]; then
        rm -rf "$tmp"
        echo "invalid GitLab source archive" >&2
        return 1
      fi

      (
        cd "$src_root"
        npm ci --ignore-scripts >/dev/null
        npm run v2:build >/dev/null
      )

      bundle_root="$tmp/gitlab-bundle"
      mkdir -p "$bundle_root/trace-service/apps/server" "$bundle_root/trace-service/apps/web"
      cp -r "$src_root/apps/server/dist" "$bundle_root/trace-service/apps/server/dist"
      cp -r "$src_root/apps/web/dist" "$bundle_root/trace-service/apps/web/dist"
      if [[ -d "$src_root/openclaw-plugin" ]]; then
        cp -r "$src_root/openclaw-plugin" "$bundle_root/trace-service/openclaw-plugin"
      fi
      cp "$src_root/apps/server/package.json" "$bundle_root/trace-service/apps/server/package.json"
      cp "$src_root/package.json" "$src_root/package-lock.json" "$src_root/run.sh" "$src_root/README.md" "$src_root/VERSION" "$src_root/claw-trace" "$src_root/install.sh" "$bundle_root/trace-service/"

      if [[ -f "$src_root/install-github.sh" ]]; then
        cp "$src_root/install-github.sh" "$bundle_root/trace-service/install-github.sh"
      fi

      if [[ -f "$src_root/install-gitlab.sh" ]]; then
        cp "$src_root/install-gitlab.sh" "$bundle_root/trace-service/install-gitlab.sh"
      fi

      tar -C "$bundle_root" -czf "$out" trace-service
      rm -rf "$tmp"
      ;;
    *)
      echo "unsupported install source: $INSTALL_SOURCE" >&2
      return 1
      ;;
  esac
}

has_systemctl() {
  command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1
}

has_journalctl() {
  command -v "$JOURNALCTL_BIN" >/dev/null 2>&1
}

system_unit_installed() {
  [[ -f "$SYSTEM_UNIT_PATH" ]]
}

user_unit_installed() {
  [[ -f "$USER_UNIT_PATH" ]]
}

systemd_available_for_mode() {
  local mode="$1"
  if ! has_systemctl; then
    return 1
  fi

  case "$mode" in
    system)
      [[ "$EUID" -eq 0 ]]
      ;;
    user)
      "$SYSTEMCTL_BIN" --user --version >/dev/null 2>&1
      ;;
    *)
      return 1
      ;;
  esac
}

service_mode() {
  if system_unit_installed && systemd_available_for_mode system; then
    echo "system"
  elif user_unit_installed && systemd_available_for_mode user; then
    echo "user"
  else
    echo "nohup"
  fi
}

systemctl_cmd() {
  local mode="$1"
  shift

  case "$mode" in
    system)
      "$SYSTEMCTL_BIN" "$@"
      ;;
    user)
      "$SYSTEMCTL_BIN" --user "$@"
      ;;
    *)
      echo "invalid systemd mode: $mode" >&2
      return 1
      ;;
  esac
}

journalctl_cmd() {
  local mode="$1"
  shift

  if [[ "$mode" == "system" ]]; then
    "$JOURNALCTL_BIN" "$@"
  elif [[ "$mode" == "user" ]]; then
    "$JOURNALCTL_BIN" --user "$@"
  else
    echo "invalid journal mode: $mode" >&2
    return 1
  fi
}

running_pid() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
  fi
  return 1
}

clear_pid_file() {
  rm -f "$PID_FILE"
}

ensure_runtime() {
  if [[ -f "$SERVER_JS" ]]; then
    return 0
  fi

  echo "claw-trace runtime is missing. run: claw-trace update" >&2
  exit 1
}

render_unit() {
  local mode="$1"
  local target="$2"

  cat > "$target" <<EOF
[Unit]
Description=claw-trace service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=$APP_DIR
Environment=NODE_ENV=production
Environment=PORT=$PORT
Environment=HOST=$HOST
Environment=SESSIONS_DIR=$SESSIONS_DIR
Environment=RAW_STREAM_FILE=$RAW_STREAM_FILE
Environment=DATABASE_FILE=$DATABASE_FILE
ExecStart=$APP_DIR/claw-trace run-server
Restart=always
RestartSec=3

[Install]
WantedBy=$(if [[ "$mode" == "system" ]]; then echo multi-user.target; else echo default.target; fi)
EOF
}

setup_service() {
  local requested_mode="auto"
  case "${1:---auto}" in
    --auto) requested_mode="auto" ;;
    --system) requested_mode="system" ;;
    --user) requested_mode="user" ;;
    *)
      echo "usage: claw-trace setup-service [--auto|--system|--user]" >&2
      exit 1
      ;;
  esac

  local mode
  if [[ "$requested_mode" == "auto" ]]; then
    if systemd_available_for_mode system; then
      mode="system"
    elif systemd_available_for_mode user; then
      mode="user"
    else
      echo "systemd unavailable; keeping nohup fallback"
      return 1
    fi
  else
    mode="$requested_mode"
    if ! systemd_available_for_mode "$mode"; then
      echo "systemd mode '$mode' is not available on this machine/user" >&2
      return 1
    fi
  fi

  local unit_path
  if [[ "$mode" == "system" ]]; then
    unit_path="$SYSTEM_UNIT_PATH"
  else
    unit_path="$USER_UNIT_PATH"
    mkdir -p "$USER_UNIT_DIR"
  fi

  local tmp_unit
  tmp_unit="$(mktemp)"
  trap 'rm -f "$tmp_unit"' RETURN
  render_unit "$mode" "$tmp_unit"
  mkdir -p "$(dirname "$unit_path")"
  cp "$tmp_unit" "$unit_path"

  if ! systemctl_cmd "$mode" daemon-reload >/dev/null 2>&1; then
    rm -f "$unit_path"
    echo "systemd detected but daemon-reload failed; using nohup fallback" >&2
    return 1
  fi

  if ! systemctl_cmd "$mode" enable "$SERVICE_NAME" >/dev/null 2>&1; then
    rm -f "$unit_path"
    systemctl_cmd "$mode" daemon-reload >/dev/null 2>&1 || true
    echo "failed to enable $SERVICE_NAME in $mode mode; using nohup fallback" >&2
    return 1
  fi

  clear_pid_file
  echo "systemd service installed: $unit_path"
  echo "service mode: $mode"
}

run_server() {
  ensure_runtime

  local node_bin
  node_bin="$(find_server_node_binary)"
  if [[ ! -x "${node_bin:-}" ]]; then
    echo "[claw-trace] no supported Node runtime found (need 18–22). Install Node ${NODE_VERSION_FALLBACK} or nvm." >&2
    exit 1
  fi

  exec env \
    NODE_ENV=production \
    PORT="$PORT" \
    HOST="$HOST" \
    SESSIONS_DIR="$SESSIONS_DIR" \
    RAW_STREAM_FILE="$RAW_STREAM_FILE" \
    DATABASE_FILE="$DATABASE_FILE" \
    "$node_bin" "$SERVER_JS"
}

start_nohup() {
  if pid="$(running_pid)"; then
    echo "claw-trace already running (pid=$pid)"
    return 0
  fi

  ensure_runtime

  nohup "$APP_DIR/claw-trace" run-server >>"$LOG_FILE" 2>&1 &

  local pid=$!
  echo "$pid" > "$PID_FILE"
  sleep 0.8

  if kill -0 "$pid" 2>/dev/null; then
    echo "claw-trace started (pid=$pid)"
    echo "mode: nohup"
    echo "url: http://$HOST:$PORT"
    echo "log: $LOG_FILE"
    echo "db: $DATABASE_FILE"
  else
    echo "failed to start. check log: $LOG_FILE" >&2
    exit 1
  fi
}

start() {
  local mode
  mode="$(service_mode)"

  if [[ "$mode" == "nohup" ]]; then
    start_nohup
    return 0
  fi

  ensure_runtime
  systemctl_cmd "$mode" daemon-reload >/dev/null 2>&1 || true
  systemctl_cmd "$mode" start "$SERVICE_NAME"

  # Poll up to 8 seconds for the service to become active.
  local i active=0
  for i in 1 2 3 4 5 6 7 8; do
    sleep 1
    if systemctl_cmd "$mode" is-active --quiet "$SERVICE_NAME"; then
      active=1
      break
    fi
  done

  if [[ "$active" -eq 1 ]]; then
    clear_pid_file
    echo "claw-trace started"
    echo "mode: systemd-$mode"
    echo "url: http://$HOST:$PORT"
    if [[ "$mode" == "system" ]]; then
      echo "logs: journalctl -u $SERVICE_NAME -f"
    else
      echo "logs: journalctl --user -u $SERVICE_NAME -f"
    fi
    echo "db: $DATABASE_FILE"
  else
    echo "failed to start via systemd ($mode)" >&2
    exit 1
  fi
}

stop() {
  local mode
  mode="$(service_mode)"

  if [[ "$mode" != "nohup" ]]; then
    systemctl_cmd "$mode" stop "$SERVICE_NAME" || true
    clear_pid_file
    echo "claw-trace stopped (mode: systemd-$mode)"
    return 0
  fi

  if pid="$(running_pid)"; then
    kill "$pid" 2>/dev/null || true
    clear_pid_file
    echo "claw-trace stopped"
  else
    echo "claw-trace is not running"
  fi
}

status() {
  local v
  v="$(version)"
  local mode
  mode="$(service_mode)"

  if [[ "$mode" != "nohup" ]]; then
    local active_state enabled_state
    active_state="$(systemctl_cmd "$mode" is-active "$SERVICE_NAME" 2>/dev/null || true)"
    enabled_state="$(systemctl_cmd "$mode" is-enabled "$SERVICE_NAME" 2>/dev/null || true)"
    echo "claw-trace $v $active_state (mode=systemd-$mode, enabled=$enabled_state)"
    if [[ "$mode" == "system" ]]; then
      echo "logs: journalctl -u $SERVICE_NAME -f"
    else
      echo "logs: journalctl --user -u $SERVICE_NAME -f"
    fi
    return 0
  fi

  if pid="$(running_pid)"; then
    echo "claw-trace $v running (pid=$pid, mode=nohup)"
    echo "log: $LOG_FILE"
  else
    echo "claw-trace $v stopped (mode=nohup)"
  fi
}

logs() {
  local mode
  mode="$(service_mode)"

  if [[ "$mode" != "nohup" ]] && has_journalctl; then
    journalctl_cmd "$mode" -u "$SERVICE_NAME" -f -n 200
    return 0
  fi

  touch "$LOG_FILE"
  tail -f "$LOG_FILE"
}

check_ok() {
  echo "✅ $1"
}

check_warn() {
  echo "⚠️  $1"
}

check_fail() {
  echo "❌ $1"
}

doctor() {
  local failed=0
  local warned=0
  local mode
  mode="$(service_mode)"

  echo "claw-trace doctor"
  echo "version: $(version)"
  echo "service_mode: $mode"
  echo "host: $HOST"
  echo "port: $PORT"
  echo "sessions_dir: $SESSIONS_DIR"
  echo "raw_stream_file: $RAW_STREAM_FILE"
  echo "raw_poll_ms: $RAW_POLL_MS"
  echo "database_file: $DATABASE_FILE"
  echo

  if [[ "$mode" != "nohup" ]]; then
    if systemctl_cmd "$mode" is-active --quiet "$SERVICE_NAME"; then
      check_ok "systemd 服务在运行 (mode=$mode)"
    else
      check_fail "systemd 服务未运行（可执行: claw-trace start）"
      failed=1
    fi

    if systemctl_cmd "$mode" is-enabled --quiet "$SERVICE_NAME"; then
      check_ok "systemd 已启用开机自启"
    else
      check_warn "systemd 未启用开机自启（可执行: claw-trace setup-service --$mode）"
      warned=1
    fi
  else
    if pid="$(running_pid)"; then
      check_ok "服务进程在运行 (pid=$pid, mode=nohup)"
    else
      check_fail "服务未运行（可执行: claw-trace start）"
      failed=1
    fi
  fi

  if [[ -d "$SESSIONS_DIR" ]]; then
    check_ok "SESSIONS_DIR 存在"
  else
    check_fail "SESSIONS_DIR 不存在: $SESSIONS_DIR"
    failed=1
  fi

  if [[ -r "$SESSIONS_DIR/sessions.json" ]]; then
    check_ok "可读取 sessions.json"
  else
    check_warn "sessions.json 不可读或不存在: $SESSIONS_DIR/sessions.json"
    warned=1
  fi

  if [[ -e "$RAW_STREAM_FILE" ]]; then
    if [[ -r "$RAW_STREAM_FILE" ]]; then
      check_ok "raw stream 文件可读"

      local size1 size2
      size1="$(wc -c < "$RAW_STREAM_FILE" 2>/dev/null || echo 0)"
      sleep 1
      size2="$(wc -c < "$RAW_STREAM_FILE" 2>/dev/null || echo 0)"

      if [[ "$size2" -gt "$size1" ]]; then
        check_ok "raw stream 文件在增长（实时链路正常写入）"
      else
        check_warn "raw stream 文件暂未增长（可能当前无请求，或网关未开启 raw stream）"
        warned=1
      fi
    else
      check_fail "raw stream 文件存在但不可读: $RAW_STREAM_FILE"
      failed=1
    fi
  else
    check_warn "raw stream 文件不存在: $RAW_STREAM_FILE"
    echo "   建议：网关启用 OPENCLAW_RAW_STREAM=1 或 --raw-stream"
    warned=1
  fi

  if command -v curl >/dev/null 2>&1; then
    if curl -fsS "http://127.0.0.1:$PORT/api/v2/health" >/dev/null 2>&1; then
      check_ok "本机 API /api/v2/health 可访问"
    else
      check_warn "本机 API /api/v2/health 不可访问（端口/监听可能异常）"
      warned=1
    fi
  else
    check_warn "未找到 curl，跳过 API 连通性检测"
    warned=1
  fi

  echo
  if [[ "$failed" -eq 1 ]]; then
    echo "doctor result: FAIL"
    exit 1
  elif [[ "$warned" -eq 1 ]]; then
    echo "doctor result: WARN"
    exit 0
  else
    echo "doctor result: OK"
    exit 0
  fi
}

diagnosis() {
  ensure_runtime

  local node_bin
  node_bin="$(find_server_node_binary)"
  if [[ ! -x "${node_bin:-}" ]]; then
    echo "[claw-trace] no supported Node runtime found (need 18–22). Install Node ${NODE_VERSION_FALLBACK} or nvm." >&2
    exit 1
  fi

  local mode
  mode="$(service_mode)"

  local state="unknown"
  local detail=""
  local log_target=""

  if [[ "$mode" != "nohup" ]]; then
    state="$(systemctl_cmd "$mode" is-active "$SERVICE_NAME" 2>/dev/null || true)"
    if [[ -z "$state" ]]; then
      state="unknown"
    fi

    if [[ "$mode" == "system" ]]; then
      log_target="journalctl -u $SERVICE_NAME -f"
    else
      log_target="journalctl --user -u $SERVICE_NAME -f"
    fi
  else
    if pid="$(running_pid)"; then
      state="running"
      detail="pid=$pid"
    else
      state="stopped"
    fi

    log_target="$LOG_FILE"
  fi

  exec env \
    NODE_ENV=production \
    PORT="$PORT" \
    HOST="$HOST" \
    SESSIONS_DIR="$SESSIONS_DIR" \
    RAW_STREAM_FILE="$RAW_STREAM_FILE" \
    DATABASE_FILE="$DATABASE_FILE" \
    CLAW_TRACE_DIAGNOSIS_SERVICE_MODE="$mode" \
    CLAW_TRACE_DIAGNOSIS_SERVICE_STATE="$state" \
    CLAW_TRACE_DIAGNOSIS_SERVICE_DETAIL="$detail" \
    CLAW_TRACE_DIAGNOSIS_LOG_TARGET="$log_target" \
    "$node_bin" "$APP_DIR/apps/server/dist/diagnosis-cli.js" "$@"
}

latest_tag() {
  case "$INSTALL_SOURCE" in
    github)
      curl -fsSL "https://api.github.com/repos/$REPO/releases/latest" \
        | grep -m1 '"tag_name"' \
        | sed -E 's/.*"tag_name"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/'
      ;;
    gitlab)
      if [[ -z "$GITLAB_BASE_URL" ]]; then
        echo "" >&2
        return 1
      fi
      normalize_gitlab_base_url
      curl -fsSL "$GITLAB_BASE_URL/api/v4/projects/$(repo_api_path)/repository/tags?per_page=1" \
        | grep -o '"name":"[^"]*"' \
        | head -n1 \
        | sed -E 's/"name":"([^"]*)"/\1/'
      ;;
    *)
      echo "" >&2
      return 1
      ;;
  esac
}

update() {
  local tag="${1:-latest}"
  if [[ "$tag" == "latest" ]]; then
    tag="$(latest_tag)"
  fi

  if [[ -z "$tag" ]]; then
    echo "unable to resolve release tag — check network or specify a version explicitly" >&2
    exit 1
  fi

  local current
  current="$(version)"
  if [[ "$current" == "$tag" ]]; then
    echo "already on $current"
    return 0
  fi

  local tmp
  tmp="$(mktemp -d)"
  trap "rm -rf '$tmp'" EXIT

  if ! prepare_update_bundle "$tag" "$tmp/trace-service.tgz" "$tmp"; then
    echo "download or build failed for $tag" >&2
    exit 1
  fi

  if ! tar -xzf "$tmp/trace-service.tgz" -C "$tmp"; then
    echo "download or extraction failed for $tag" >&2
    exit 1
  fi

  local src="$tmp/trace-service"
  if [[ ! -f "$src/claw-trace" ]]; then
    echo "invalid bundle: claw-trace command missing" >&2
    exit 1
  fi

  if [[ ! -f "$src/package-lock.json" ]]; then
    echo "invalid bundle: package-lock.json missing" >&2
    exit 1
  fi

  if [[ ! -f "$src/apps/server/dist/index.js" ]]; then
    echo "invalid bundle: server runtime missing (apps/server/dist/index.js)" >&2
    exit 1
  fi

  local was_running=0
  local mode_before
  mode_before="$(service_mode)"
  if [[ "$mode_before" != "nohup" ]]; then
    if systemctl_cmd "$mode_before" is-active --quiet "$SERVICE_NAME"; then
      was_running=1
    fi
    stop
    # Wait up to 5s for systemd to actually stop the service before overwriting files.
    local i
    for i in 1 2 3 4 5; do
      systemctl_cmd "$mode_before" is-active --quiet "$SERVICE_NAME" 2>/dev/null || break
      sleep 1
    done
  elif running_pid >/dev/null; then
    was_running=1
    stop
    sleep 1
  fi

  local backup_dir="$APP_DIR.backup.$(date +%Y%m%d-%H%M%S)"
  cp -a "$APP_DIR" "$backup_dir"
  echo "backup saved to $backup_dir"

  # Unlink the running script before overwriting so bash's open fd keeps reading
  # the old inode while the new file gets a fresh inode (prevents mid-script
  # parse errors when bash reads the file while it is being replaced in place).
  rm -f "$APP_DIR/claw-trace"
  cp -a "$src/." "$APP_DIR/"
  # build-bundle.sh is a dev tool not included in release bundles; ignore if absent.
  chmod +x "$APP_DIR/claw-trace" "$APP_DIR/run.sh" 2>/dev/null || true
  write_install_source_file

  # Re-create the ~/.local/bin symlink so the command stays reachable after update.
  local bin_dir="${CLAW_TRACE_BIN_DIR:-$HOME/.local/bin}"
  mkdir -p "$bin_dir"
  ln -sf "$APP_DIR/claw-trace" "$bin_dir/claw-trace"

  # Load nvm if available so that npm and node are in PATH.
  # shellcheck source=/dev/null
  [[ -s "$HOME/.nvm/nvm.sh" ]] && source "$HOME/.nvm/nvm.sh"

  local npm_bin
  npm_bin="$(command -v npm 2>/dev/null || true)"

  if [[ -z "$npm_bin" ]]; then
    echo "npm not found — skipping dependency install (existing node_modules kept)" >&2
    echo "if the service fails to start, run: npm ci --omit=dev --workspace @claw-trace/server" >&2
    # Don't restore backup: new files are already in place and old node_modules are preserved.
    echo "updated: $current -> $(version)"
    if [[ "$was_running" == "1" ]]; then
      "$APP_DIR/claw-trace" start
    fi
    return 0
  fi

  echo "installing runtime dependencies for this machine"
  if ! (cd "$APP_DIR" && "$npm_bin" ci --omit=dev --workspace @claw-trace/server --include-workspace-root=false); then
    echo "npm ci failed — restoring backup" >&2
    cp -a "$backup_dir/." "$APP_DIR/"
    if [[ "$was_running" == "1" ]]; then
      "$APP_DIR/claw-trace" start
    fi
    exit 1
  fi

  inject_openclaw_doctor_plugin || true
  restart_openclaw_gateway || true

  echo "updated: $current -> $(version)"
  "$APP_DIR/claw-trace" start
}

rollback() {
  local latest_backup
  latest_backup="$(ls -dt "$APP_DIR".backup.* 2>/dev/null | head -n1 || true)"
  if [[ -z "$latest_backup" ]]; then
    echo "no backup found"
    exit 1
  fi

  local was_running=0
  local mode_before
  mode_before="$(service_mode)"
  if [[ "$mode_before" != "nohup" ]]; then
    if systemctl_cmd "$mode_before" is-active --quiet "$SERVICE_NAME"; then
      was_running=1
    fi
    stop
  elif running_pid >/dev/null; then
    was_running=1
    stop
  fi

  cp -a "$latest_backup/." "$APP_DIR/"
  "$APP_DIR/claw-trace" setup-service --auto >/dev/null 2>&1 || true
  echo "rolled back using $latest_backup"
  "$APP_DIR/claw-trace" start
}

usage() {
  cat <<EOF
claw-trace commands:
  start                      Start service
  stop                       Stop service
  restart                    Restart service
  status                     Show service status
  logs                       Tail service logs
  doctor                     Health checks (process/files/api/raw-stream)
  diagnosis                  Diagnose current OpenClaw/session state
  version                    Show installed version
  setup-service [--auto|--system|--user]
                             Install and enable a systemd unit when available
  service-mode               Show current service manager mode
  update [tag]               Update from the configured source (default: latest)
  rollback                   Roll back to latest local backup
EOF
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  logs) logs ;;
  doctor) doctor ;;
  diagnosis|-diagnosis) diagnosis "$@" ;;
  version) version ;;
  setup-service) setup_service "${1:---auto}" ;;
  service-mode) service_mode ;;
  run-server) run_server ;;
  update) update "${1:-latest}" ;;
  rollback) rollback ;;
  *) usage; exit 1 ;;
esac
